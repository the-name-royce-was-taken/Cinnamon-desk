run = """
pkill -f Xvnc || true
pkill -f webvnc.py || true
pkill -x tint2 || true

Xvnc :0 -rfbport=5900 -SecurityTypes=None -geometry 1920x1200 &
sleep 2

export XDG_CONFIG_HOME="$PWD/.config"
export GTK2_RC_FILES="$PWD/.gtkrc-2.0"
# Include user, project, Nix profile, system and standard application directories.
# Rofi's drun mode scans these locations for .desktop launchers.
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_DATA_DIRS="$HOME/.local/share:$PWD/.local/share:$HOME/.nix-profile/share:/nix/var/nix/profiles/per-user/$USER/profile/share:/nix/var/nix/profiles/default/share:/run/current-system/sw/share:/usr/local/share:/usr/share"
export GTK_THEME=Yaru-dark

DISPLAY=:0 vncconfig -nowin &

# Install this repository's Fluxbox style and keybindings into the runtime home.
mkdir -p "$HOME/.fluxbox/styles"
cp "$PWD/.fluxbox/styles/YaruDesk" "$HOME/.fluxbox/styles/YaruDesk"
cat > "$HOME/.fluxbox/init" <<EOF
session.styleFile: $HOME/.fluxbox/styles/YaruDesk
session.keyFile: $PWD/.fluxbox/keys
session.screen0.toolbar.visible: false
session.screen0.toolbar.autoHide: false
session.screen0.workspaces: 1
session.screen0.focusModel: ClickToFocus
session.screen0.fullMaximization: false
EOF

DISPLAY=:0 fluxbox &
sleep 1

# Draw the PCManFM desktop (background and desktop icons), not a file-manager window.
DISPLAY=:0 pcmanfm --desktop --profile=default &

# Explicitly launch the custom taskbar and keep diagnostics if it fails.
DISPLAY=:0 tint2 -c "$PWD/.config/tint2/tint2rc" >/tmp/tint2.log 2>&1 &

DISPLAY=:0 xfce4-terminal &
DISPLAY=:0 chromium --no-sandbox &

# Reuse an already-running web VNC bridge instead of crashing on port 8080.
python3 -c 'import socket; s=socket.socket(); s.settimeout(0.25); rc=s.connect_ex(("127.0.0.1",8080)); s.close(); raise SystemExit(0 if rc == 0 else 1)' \
  && echo "webvnc.py already listening on port 8080; reusing it" \
  || python3 webvnc.py
"""

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 8080
externalPort = 80
