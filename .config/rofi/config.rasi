configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Yaru";
    font: "Sans 11";
    display-drun: "All applications";
    drun-display-format: "{name}";
    drun-match-fields: "name,generic,exec,categories,keywords";
    disable-history: false;
    sorting-method: "fzf";
    hover-select: false;
    matching: "fuzzy";
}
* {
    background: #24232e;
    background-alt: #34333f;
    foreground: #f4f4f5;
    selected: #e95420;
    active: #a0a0aa;
    urgent: #e95420;
    border-color: #e95420;
}
window {
    width: 42%;
    border: 2px;
    border-radius: 12px;
    border-color: @border-color;
    background-color: @background;
}
mainbox {
    padding: 12px;
    background-color: @background;
    children: [ inputbar, listview ];
    spacing: 12px;
}
inputbar {
    padding: 10px;
    border-radius: 8px;
    background-color: @background-alt;
    children: [ prompt, entry ];
}
prompt {
    text-color: @selected;
    background-color: transparent;
    padding: 0px 8px 0px 0px;
}
entry {
    text-color: @foreground;
    background-color: transparent;
    placeholder: "Search all applications";
    placeholder-color: @active;
}
listview {
    columns: 1;
    lines: 14;
    fixed-height: true;
    spacing: 4px;
    scrollbar: false;
    background-color: transparent;
}
element {
    padding: 8px;
    border-radius: 7px;
    background-color: transparent;
    text-color: @foreground;
}
element selected {
    background-color: @selected;
    text-color: #ffffff;
}
element-icon {
    size: 24px;
    background-color: transparent;
}
element-text {
    vertical-align: 0.5;
    background-color: transparent;
}
