# Cinnamon-desk visual panel: Windows-like taskbar with Ubuntu/Yaru colors
# Panel items: E=Start launcher, T=window list, S=system tray, C=clock
panel_items = ETSC
panel_monitor = all
panel_position = bottom center horizontal
panel_size = 100% 42
panel_margin = 0 0
panel_padding = 7 4 7
panel_background_id = 1
panel_dock = 0
panel_layer = top
panel_shrink = 0
panel_autohide = 0
panel_sort = ascending
panel_urgent_blink = 1
panel_window_name = 0
panel_font = Sans 9

# Backgrounds
rounded = 8
border_width = 0
background_color = #20202a 96
border_color = #20202a 0
rounded = 8
background_color = #e95420 100
border_color = #e95420 100
rounded = 6
background_color = #3b3b48 100
border_color = #3b3b48 100
rounded = 6
background_color = #e95420 100
border_color = #e95420 100

# Start button: click to open the Rofi application menu
execp = new
execp_command = echo "Start"
execp_interval = 60
execp_has_icon = 0
execp_cache_icon = 0
execp_continuous = 0
execp_markup = 0
execp_tooltip = Open applications
execp_font = Sans Bold 10
execp_font_color = #ffffff 100
execp_padding = 12 4
execp_background_id = 2
execp_centered = 1
execp_lclick_command = rofi -show drun

# Task list
taskbar_mode = multi_desktop
taskbar_padding = 3 2 3
taskbar_background_id = 0
taskbar_active_background_id = 3
taskbar_name = 0
taskbar_hide_different_monitor = 0
taskbar_hide_different_desktop = 0
taskbar_always_show_all_desktop = 0
taskbar_distribute_size = 1
taskbar_sort_order = none
taskbar_align = left

task_icon = 1
task_text = 1
task_centered = 0
task_maximum_size = 220 34
task_padding = 8 4 8
task_font = Sans 9
task_font_color = #eeeeee 100
task_active_font_color = #ffffff 100
task_background_id = 0
task_active_background_id = 3
task_urgent_background_id = 4
task_iconified_background_id = 0
task_tooltip = 1
task_thumbnail = 0

# System tray
systray_padding = 7 4 7
systray_background_id = 0
systray_sort = ascending
systray_icon_size = 20
systray_icon_asb = 100 0 0

# Clock
time1_format = %H:%M
time2_format = %a %d %b
clock_font = Sans 9
clock_font_color = #ffffff 100
clock_padding = 8 2
clock_background_id = 0
clock_tooltip = %A, %d %B %Y

# Tooltips
tooltip_show_timeout = 0.5
tooltip_hide_timeout = 0.1
tooltip_padding = 6 4
tooltip_background_id = 1
tooltip_font = Sans 9
tooltip_font_color = #ffffff 100
